# Dependencies and build output
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/

# Local reference clones (not part of the project)
reference/
everything-claude-code/

# Tool output
.playwright-mcp/
apps/*/docs/screenshots/*.png
!apps/*/docs/screenshots/.gitkeep

# Offline AI model files live in each app's models/ (gitignored there)
apps/*/models/*
!apps/*/models/.gitkeep

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*service-account*.json
gemini_api_key.txt

# Raw GIS sources stay on the local drive; only converted GeoJSON is committed
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.kmz

# Claude Code local settings
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
