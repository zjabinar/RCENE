# Dependencies and build output
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/

# Tool output
.playwright-mcp/
test-results/
playwright-report/

# Smoke-test screenshots (regenerated by `npm run smoke`)
docs/screenshots/*.png

# Offline AI model files: large, fetched with `npm run fetch-models`
models/*
!models/.gitkeep

# Raw GIS archive: local copy only (sources/gis/raw), never committed.
# Only the converted GeoJSON in data/files is committed.
sources/gis/raw/
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.kmz

# Local reference clones (not part of the project)
reference/

# Secrets: never commit
.env
.env.*
!.env.example
*.pem
*service-account*.json
gemini_api_key.txt

# Claude Code local settings
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
