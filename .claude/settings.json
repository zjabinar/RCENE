{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ECC_GATEGUARD": "off"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm smoke *)",
      "Bash(pnpm new-app *)",
      "Bash(pnpm sync-shared *)",
      "Bash(pnpm sync-data *)",
      "Bash(pnpm lockfiles *)",
      "Bash(pnpm check-standalone *)",
      "Bash(pnpm stack:check *)",
      "Bash(pnpm data:fixtures *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(node scripts/*)",
      "Bash(ls *)",
      "PowerShell(pnpm install *)",
      "PowerShell(pnpm --filter *)",
      "PowerShell(pnpm exec *)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm typecheck *)",
      "PowerShell(pnpm build *)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm smoke *)",
      "PowerShell(pnpm new-app *)",
      "PowerShell(pnpm sync-shared *)",
      "PowerShell(pnpm sync-data *)",
      "PowerShell(pnpm lockfiles *)",
      "PowerShell(pnpm check-standalone *)",
      "PowerShell(pnpm stack:check *)",
      "PowerShell(pnpm data:fixtures *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(node scripts/*)",
      "mcp__playwright__*"
    ],
    "deny": [
      "Read(//d/monica/**)",
      "Edit(//d/monica/**)",
      "Read(//c/lgu_portal/**)",
      "Edit(//c/lgu_portal/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(!**/.env.example)",
      "Read(**/*service-account*.json)",
      "Read(**/gemini_api_key.txt)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/session-context.mjs"
            ],
            "timeout": 600,
            "statusMessage": "Loading RCENE project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ]
}
