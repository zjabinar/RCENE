# /srv/rscene/.env on the VPS (owner deploy:www-data, mode 640). Loaded by systemd
# (EnvironmentFile=) for rscene-api.service. Never commit the real file.
# server-setup.sh creates it from this template (without overwriting an existing one).
# Fill the keys on the server (nano /srv/rscene/.env), or push the AI lines of your
# laptop's .env.local with: npm run deploy -- --push-env

# Where the relay listens (nginx proxies /api/ here). Port 8010: 8001-8009 are taken.
PORT=8010
HOST=127.0.0.1

# Public-site protection: completions per minute for the whole server (0 = no limit),
# and refuse POSTs without an Origin header (browsers always send it).
AI_RATE_LIMIT_PER_MIN=30
AI_REQUIRE_ORIGIN=1

# Default provider: demo | openai | anthropic | gemini | local
AI_PROVIDER=openai
AI_TIMEOUT_MS=30000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
