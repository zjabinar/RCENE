{
  "name": "rcene",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "test": "vitest run && pnpm -r --workspace-concurrency=4 test",
    "build": "pnpm -r --workspace-concurrency=2 build",
    "lint": "oxlint scripts",
    "smoke": "node scripts/smoke.mjs",
    "new-app": "node scripts/new-app.mjs",
    "sync-shared": "node scripts/sync-shared.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "lockfiles": "node scripts/lockfiles.mjs",
    "check-standalone": "node scripts/check-standalone.mjs",
    "stack:check": "node scripts/stack.mjs --check",
    "data:fixtures": "node scripts/data/make-fixtures.mjs && node scripts/data/derive.mjs --fixtures"
  },
  "devDependencies": {
    "@tmcw/togeojson": "7.1.2",
    "@turf/turf": "7.4.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "mapshaper": "0.6.121",
    "oxlint": "1.86.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
